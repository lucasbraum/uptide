{
  "name": "synthetic-task-fields",
  "private": true,
  "license": "Apache-2.0",
  "dependencies": {
    "husky": "1.0.0",
    "lint-staged": "1.0.0",
    "pretty-quick": "1.0.0",
    "prettier": "1.0.0",
    "standard": "1.0.0",
    "simple-git-hooks": "1.0.0",
    "hook-worker": "1.0.0",
    "ava": "1.0.0",
    "xo": "1.0.0",
    "custom-tool": "1.0.0",
    "orphan": "1.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "standard --fix",
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-push": "check-hooks"
  },
  "standard": {},
  "ava": {},
  "xo": {},
  "custom-tool": {
    "enabled": true
  }
}
