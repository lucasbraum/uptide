{
  "name": "uptide",
  "version": "0.3.0",
  "description": "Uptide finds what a dependency upgrade breaks in your code, migrates it, and proves it with your compiler and tests.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "uptide": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/metafile-*.json",
    "NOTICE",
    "THIRD-PARTY-NOTICES"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uptide-dev/uptide.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/uptide-dev/uptide#readme",
  "bugs": "https://github.com/uptide-dev/uptide/issues",
  "keywords": [
    "zod",
    "stripe",
    "upgrade",
    "migration",
    "codemod",
    "breaking-changes",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/third-party-notices.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/prepack.mjs --clean"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@uptide/core": "workspace:*",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
