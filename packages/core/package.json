{
  "name": "@uptide/core",
  "version": "0.1.0",
  "description": "Contract diff engine: what a dependency upgrade changes in its public API.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./list-worker": {
      "types": "./dist/list-worker.d.ts",
      "import": "./dist/list-worker.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ignore": "^7.0.12",
    "ini": "^5.0.0",
    "semver": "^7.8.5",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/ini": "^4.1.1",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "private": true
}
